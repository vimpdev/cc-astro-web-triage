---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";

const title = "Web Triage";
const description = "Front-end Diagnostic Lab";
---

<BaseLayout title="Home">
	<h1>{title}</h1>
	<p>{description}</p>

	<CaseCard
		title="Broken Image"
		category="Assets"
		difficulty="Junior"
		featured={true}
	/>
	<CaseCard
		title="TypeScript Props Error"
		category="TypeScript"
		difficulty="Junior"
	/>
</BaseLayout>
